#!/usr/bin/env python3

import argparse
import logging
import subprocess

import nagiosplugin

logger = logging.getLogger(__name__)


class BooleanContext(nagiosplugin.Context):
    """Return CRITICAL if a boolean (true or false) doesn't have the expected value"""

    def __init__(self, name, level, expected=True):
        super().__init__(name)
        self.level = level
        self.expected = expected

    def evaluate(self, metric, resource):
        if metric.value is self.expected:
            state = nagiosplugin.state.Ok
        else:
            state = self.level
        return self.result_cls(state, metric.name, metric)


class Luks(nagiosplugin.Resource):
    """Nagios resource used to gather metrics from LUKS devices"""

    def __init__(self, command, devices):
        self.command = command
        self.devices = devices
        self.metrics = []

    def check_is_luks(self):
        """Check if devices are encrypted with LUKS"""
        for device in self.devices:
            logger.debug(f"checking device {device}")
            p = subprocess.run(["cryptsetup", "isLuks", device], capture_output=True)
            logger.debug(p)
            self.metrics.append(
                nagiosplugin.Metric(device, p.returncode == 0, context="is_luks")
            )

        if not self.metrics:
            return [nagiosplugin.Metric("No device", True, context="is_luks")]

        return self.metrics

    def probe(self):
        """Gather all metrics"""
        func_name = f"check_{self.command}"
        if hasattr(self, func_name) and callable(getattr(self, func_name)):
            return getattr(self, func_name)()


class Summary(nagiosplugin.Summary):
    """Display results nicely"""

    def problem(self, results):
        return ", ".join(
            sorted(
                f"{r} ({r.metric.value})"
                for r in results
                if r.state != nagiosplugin.state.Ok
            )
        )

    def ok(self, results):
        return ", ".join(sorted(f"{r} ({r.metric.value})" for r in results))


def parse_args():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "-v",
        "--verbose",
        dest="loglevel",
        action="store_const",
        const=logging.INFO,
        help="Print more output",
    )
    parser.add_argument(
        "-d",
        "--debug",
        dest="loglevel",
        action="store_const",
        const=logging.DEBUG,
        default=logging.WARNING,
        help="Print even more output",
    )

    parser.add_argument(
        "-D",
        "--device",
        dest="device",
        action="append",
        default=[],
        help="List of devices",
    )

    subparsers = parser.add_subparsers(dest="command")

    is_luks = subparsers.add_parser(
        "is_luks", help="Check if devices are encrypted with LUKS"
    )
    is_luks.add_argument(
        "--warning",
        dest="level",
        action="store_const",
        const=nagiosplugin.state.Warn,
        default=nagiosplugin.state.Critical,
        help="Return warning alert instead of critical",
    )

    return parser.parse_args()


def setup_logging(args):
    logging.basicConfig(format="%(levelname)s: %(message)s", level=args.loglevel)


@nagiosplugin.guarded
def main():
    args = parse_args()
    setup_logging(args)

    if args.command == "is_luks":
        context = BooleanContext("is_luks", level=args.level)
    else:
        raise nagiosplugin.CheckError("Invalid command")

    resource = Luks(command=args.command, devices=args.device)
    summary = Summary()

    check = nagiosplugin.Check(resource, context, summary)
    check.main()


if __name__ == "__main__":
    main()
